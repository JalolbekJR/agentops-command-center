{
  "name": "agentops-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Local deterministic demo scaffold for an AI agent operations command center.",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "api:verify-exposure": "node scripts/verify-api-exposure.mjs",
    "api:verify-auth-boundary": "node scripts/verify-api-auth-boundary.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:seed": "tsc -p tsconfig.tooling.json && node .tooling-build/scripts/seed-db.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "latest",
    "pg": "^8.21.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
